# ============================================================
# Gold Knowledge Chatbot — Environment Variables Reference
# ============================================================
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าของคุณ
# cp .env.example .env
#
# ⚠️  ห้าม commit ไฟล์ .env จริงขึ้น Git เด็ดขาด
#     เพิ่ม .env ใน .gitignore
# ============================================================


# ------------------------------------------------------------
# 🤖 OpenAI
# ------------------------------------------------------------
# API Key สำหรับ GPT-4o-mini
# สมัครและสร้าง Key ได้ที่: https://platform.openai.com/api-keys
# ใช้ใน Node: OpenAI Chat Model (ตั้งผ่าน n8n Credentials)

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# โมเดลที่ใช้ (อย่าเปลี่ยนถ้าไม่จำเป็น)
OPENAI_MODEL=mdt/gpt-4o-mini


# ------------------------------------------------------------
# 💬 LINE Messaging API
# ------------------------------------------------------------
# Channel Access Token (Long-lived)
# สร้างได้ที่: LINE Developers Console > Messaging API > Channel access token
# ใช้ใน Node: Reply LINE (Authorization: Bearer <TOKEN>)
# ⚠️  ห้ามแชร์ Token นี้กับใคร

LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Channel Secret
# ใช้สำหรับตรวจสอบ Webhook Signature (ถ้าต้องการเพิ่ม security)
# ดูได้ที่: LINE Developers Console > Basic settings > Channel secret

LINE_CHANNEL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ------------------------------------------------------------
# 🌍 GoldAPI.io — ราคาทองโลก (XAU/USD)
# ------------------------------------------------------------
# สมัครและรับ Token ได้ที่: https://www.goldapi.io/dashboard
# แผนฟรีมี request limit ต่อเดือน
# ใช้ใน Node: Get World Gold (Header: x-access-token)

GOLDAPI_ACCESS_TOKEN=goldapi-xxxxxxxxxxxxxxxx-io

# Endpoint (ไม่ต้องเปลี่ยน)
GOLDAPI_ENDPOINT=https://www.goldapi.io/api/XAU/USD


# ------------------------------------------------------------
# 🇹🇭 Thai Gold API — ราคาทองไทย
# ------------------------------------------------------------
# Public API ไม่ต้องการ Key และไม่มีค่าใช้จ่าย
# ใช้ใน Node: Get Thai Gold

THAI_GOLD_API_ENDPOINT=https://api.chnwt.dev/thai-gold-api/latest


# ------------------------------------------------------------
# 📱 LINE LIFF App (Optional)
# ------------------------------------------------------------
# LIFF ID สำหรับ Gold Dashboard (ปุ่มใน Flex Message)
# สร้างได้ที่: LINE Developers Console > LIFF
# ถ้าไม่มี LIFF App ให้ปล่อยว่างหรือใส่ URL อื่นแทน
# ใช้ใน Node: Build Flex Message (uri ในปุ่ม footer)

LIFF_URL=https://liff.line.me/xxxxxxxxxxxx-xxxxxxxx


# ------------------------------------------------------------
# ⚙️ n8n Settings (สำหรับ Self-hosted เท่านั้น)
# ------------------------------------------------------------
# Webhook Path (ตรงกับที่ตั้งใน Webhook Node)
N8N_WEBHOOK_PATH=gold-bot

# Base URL ของ n8n instance (ใช้ตั้งค่า Webhook URL)
# สำหรับ n8n Cloud: ค่านี้ auto-generate ไม่ต้องกำหนด
N8N_BASE_URL=https://your-n8n-instance.app.n8n.cloud

# Webhook URL เต็ม (อ้างอิงสำหรับตั้งใน LINE Developers Console)
# N8N_WEBHOOK_URL=${N8N_BASE_URL}/webhook/${N8N_WEBHOOK_PATH}
# ตัวอย่าง: https://your-n8n-instance.app.n8n.cloud/webhook/gold-bot
